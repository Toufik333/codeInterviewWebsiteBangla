# MongoDB Connection String (Atlas or Local)
# Replace with your actual connection URI in .env:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ctci_db?retryWrites=true&w=majority

# JWT Secret Key for token generation
JWT_SECRET=super_secret_ctci_jwt_key_change_me_in_production_12345

# Local Server Port (optional, defaults to 3000)
PORT=3000
